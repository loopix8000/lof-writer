{
  "name": "lof-writer",
  "productName": "Lof Writer",
  "version": "1.1.3",
  "private": true,
  "description": "Local First Writing Tool",
  "author": "Lof Writer",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tauri dev",
    "android:dev": "node scripts/build-android-apk.mjs --target=x86_64 --run",
    "android:run": "node scripts/build-android-apk.mjs --target=x86_64 --run-only",
    "android:build": "node scripts/build-android-apk.mjs",
    "tauri": "tauri",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/package-tauri.mjs dir",
    "smoke": "node scripts/smoke.mjs",
    "smoke:navigation": "node scripts/navigation-smoke.mjs",
    "smoke:edge": "node scripts/edge-smoke.mjs",
    "smoke:features": "node scripts/features-smoke.mjs",
    "mcp": "node scripts/mcp.mjs",
    "diagnose:iroh": "node scripts/iroh-diagnostics-api.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "package:dir": "node scripts/package-tauri.mjs dir",
    "licenses": "node scripts/generate-licenses.mjs",
    "package:msi": "node scripts/package-tauri.mjs msi",
    "release:local": "node scripts/release-local.mjs",
    "android:release:local": "node scripts/release-local.mjs --android",
    "updater:prepare": "node scripts/prepare-updater.mjs",
    "updater:keygen": "node scripts/generate-updater-key.mjs",
    "smoke:chrome": "node scripts/chrome-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@floating-ui/dom": "^1.8.0",
    "@lezer/markdown": "^1.8.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/markdown": "^3.0.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "entities": "6.0.1",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "basic-ftp": "^6.2.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "webdav": "^5.11.0"
  }
}
